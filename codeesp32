
#define pinoControle 19 // Pino que comanda a carga (digital)
#define pinoLeituraAnalogica 32  // Pino que lê o valor para plotagem
#define pinoLED 21 // Pino que controla o LED
#define pinoLeituraDigital 18 // Pino que lê o valor digital do capacitor para o LED
#define periodo 20 // Período em milisegundos da saida digital
#define frequencia 2 // Frequência
int leitura;

void setup() { 
  Serial.begin(115200);
  pinMode(pinoControle, OUTPUT);
  pinMode(pinoLeituraDigital, INPUT);
  pinMode(pinoLED, OUTPUT);
}

void loop() {

  // Carga
  digitalWrite(pinoControle, HIGH); // Liga os 5V para carregar
  leitura = digitalRead(pinoLeituraDigital);
  digitalWrite(pinoLED, leitura);
  for (int i = 0; i < frequencia; i++) { 
    plotarDados();
    delay(periodo); 
  }

  // Descarga
  digitalWrite(pinoControle, LOW);  // Desliga o GND para descarregar
  leitura = digitalRead(pinoLeituraDigital);
  digitalWrite(pinoLED, leitura);
  for (int i = 0; i < frequencia; i++) { 
    plotarDados();
    delay(periodo); 
  }
}

// Plotar com os limites travados
void plotarDados() {
  int tensao = analogRead(pinoLeitura);

  // Truque clássico do "Internet e Coisas" adaptado ao experimento:
  Serial.print(0);                // Linha inferior fixa (0V)
  Serial.print(",");
  Serial.print(4095);             // Linha superior fixa (3,3V)
  Serial.print(",");
  Serial.println(tensao);         // Plota a curva carga/descarga
}
